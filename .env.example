# Copy this file to backend/.env and fill in your own values. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Optional backup model used automatically if the main one is overloaded (503)
GEMINI_FALLBACK_MODEL=
# Optional: a stronger model just for reading the client's message (helps Marathi/Hindi/Tamil)
GEMINI_EXTRACT_MODEL=
# Seconds to wait for Gemini before retrying (helps on unstable networks)
GEMINI_TIMEOUT_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Quotation email (Stage 6). Leave SMTP_* empty to save emails to backend/data/outbox instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_NAME=WaveNxD Sales Assistant
SENDER_EMAIL=
# Optional: a team inbox that gets a hidden copy of every quotation request
SALES_TEAM_EMAIL=
